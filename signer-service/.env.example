PORT=3000
BLOCKCHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BLOCKCHAIN_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
ADMIN_PRIVATE_KEY=0xYOUR_OWNER_PRIVATE_KEY
ADMIN_MASTER_KEY_ID=ADMIN_MASTER_KEY
SIGNER_API_TOKEN=replace-with-the-same-long-random-token-as-laravel
# Exactly 32 UTF-8 bytes. Back up securely; changing it makes stored wallet keys unreadable.
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef
MIN_WALLET_BALANCE_ETH=0.001
GAS_TOPUP_AMOUNT_ETH=0.003
